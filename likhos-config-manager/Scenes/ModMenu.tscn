[gd_scene format=3]

[ext_resource type="Theme" path="res://UI/Themes/Theme.tres" id="theme"]
[ext_resource type="Script" path="res://mods/likhos-config-manager/Scripts/ModMenu.gd" id="script"]
[ext_resource type="Texture2D" path="res://Editor/RTV_Background.png" id="background"]
[ext_resource type="Material" path="res://UI/Effects/MT_Menu.tres" id="menu_material"]

[node name="ModMenu" type="Control"]
; the settings screen is shown while the game is paused
process_mode = 3
visible = false
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Backdrop" type="TextureRect" parent="."]
material = ExtResource("menu_material")
anchor_right = 1.0
anchor_bottom = 1.0
texture = ExtResource("background")
expand_mode = 1
stretch_mode = 6

[node name="Shade" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.8)

[node name="Margin" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 80
theme_override_constants/margin_top = 50
theme_override_constants/margin_right = 80
theme_override_constants/margin_bottom = 50

[node name="Layout" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 40

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]

[node name="Caption" type="Label" parent="Margin/Layout/Header"]
size_flags_horizontal = 3
theme_type_variation = &"HeaderLarge"
theme_override_font_sizes/font_size = 24
text = "Likho's Config Manager"
vertical_alignment = 1

[node name="Back" type="Button" parent="Margin/Layout/Header"]
custom_minimum_size = Vector2(256, 40)
text = "← Return"

[node name="Columns" type="HBoxContainer" parent="Margin/Layout"]
size_flags_vertical = 3
theme_override_constants/separation = 32

[node name="ModsColumn" type="VBoxContainer" parent="Margin/Layout/Columns"]
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="TitlePanel" type="PanelContainer" parent="Margin/Layout/Columns/ModsColumn"]
custom_minimum_size = Vector2(0, 50)

[node name="Title" type="Label" parent="Margin/Layout/Columns/ModsColumn/TitlePanel"]
text = "Mods"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Search" type="LineEdit" parent="Margin/Layout/Columns/ModsColumn"]
custom_minimum_size = Vector2(0, 32)
placeholder_text = "Search mods..."
clear_button_enabled = true

[node name="Scroll" type="ScrollContainer" parent="Margin/Layout/Columns/ModsColumn"]
size_flags_vertical = 3

[node name="ModList" type="VBoxContainer" parent="Margin/Layout/Columns/ModsColumn/Scroll"]
unique_name_in_owner = true
size_flags_horizontal = 3

[node name="PageColumn" type="VBoxContainer" parent="Margin/Layout/Columns"]
size_flags_horizontal = 3
size_flags_stretch_ratio = 4.0
theme_override_constants/separation = 10

[node name="TitlePanel" type="PanelContainer" parent="Margin/Layout/Columns/PageColumn"]
custom_minimum_size = Vector2(0, 50)

[node name="PageTitle" type="Label" parent="Margin/Layout/Columns/PageColumn/TitlePanel"]
unique_name_in_owner = true
text = "Settings"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Margin/Layout/Columns/PageColumn"]
size_flags_vertical = 3

[node name="Rows" type="VBoxContainer" parent="Margin/Layout/Columns/PageColumn/Scroll"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 10

[connection signal="pressed" from="Margin/Layout/Header/Back" to="." method="close"]
[connection signal="text_changed" from="Margin/Layout/Columns/ModsColumn/Search" to="." method="_on_search_text_changed"]
